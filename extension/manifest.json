{
    "manifest_version": 3,
    "name": "Petrik helyetessítés fixer",
    "version": "2.3",
    "content_scripts": [
        {
            "matches": ["https://helyettesites.petrik.hu/*"],
            "js": ["js/script.js"]
        }
    ],
    
    "browser_specific_settings": {
        "gecko": {
            "id": "petrik@example.com",
            "strict_min_version": "140.0",
            "data_collection_permissions": {"required": ["none"]}   
        }
    }
}